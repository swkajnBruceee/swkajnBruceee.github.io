#loading-box(onclick='document.getElementById("loading-box").classList.add("loaded")')
  .loading-left-bg
  .loading-right-bg
  .wizard-scene
    .wizard-objects
      .wizard-square
      .wizard-circle
      .wizard-triangle
    .wizard
      .wizard-body
      .wizard-right-arm
        .wizard-right-hand
      .wizard-left-arm
        .wizard-left-hand
      .wizard-head
        .wizard-beard
        .wizard-face
          .wizard-adds
        .wizard-hat
          .wizard-hat-of-the-hat
          .wizard-four-point-star.--first
          .wizard-four-point-star.--second
          .wizard-four-point-star.--third
script.
  (()=>{
    const $loadingBox = document.getElementById('loading-box')
    let timeout
    const endLoading = () => {
      clearTimeout(timeout)
      $loadingBox.classList.add('loaded')
    }
    const initLoading = () => {
      clearTimeout(timeout)
      $loadingBox.classList.remove('loaded')
      timeout = setTimeout(endLoading, 3000)
    }
    initLoading()
    document.addEventListener('DOMContentLoaded', endLoading, { once: true })
    window.addEventListener('pageshow', endLoading)
    if (!{theme.pjax && theme.pjax.enable}) {
      document.addEventListener('pjax:send', initLoading)
      document.addEventListener('pjax:complete', endLoading)
      document.addEventListener('pjax:error', endLoading)
    }
  })()
