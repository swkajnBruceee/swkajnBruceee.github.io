- const serverURL = theme.waline.serverURL.replace(/\/$/, '')
script.
  (() => {
    const elements = [...document.querySelectorAll('#recent-posts .waline-comment-count')]
    if (!elements.length) return
    const controller = new AbortController()
    const cancel = () => controller.abort()
    document.addEventListener('pjax:send', cancel, { once: true })
    const timeout = setTimeout(cancel, 10000)
    const params = new URLSearchParams({ type: 'count', url: elements.map(item => item.dataset.path).join(',') })
    fetch('!{serverURL}/api/comment?' + params, { signal: controller.signal })
      .then(response => {
        if (!response.ok) throw new Error('评论计数加载失败')
        return response.json()
      })
      .then(result => {
        if (!Array.isArray(result.data) || result.data.length !== elements.length) throw new Error('评论计数格式无效')
        elements.forEach((element, index) => { element.textContent = result.data[index] })
      })
      .catch(() => {
        elements.forEach(element => {
          element.textContent = '—'
          element.title = '评论数暂不可用'
        })
      })
      .finally(() => {
        clearTimeout(timeout)
        document.removeEventListener('pjax:send', cancel)
      })
  })()
